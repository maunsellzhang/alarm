<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="轻提醒" Width="820" Height="760" MinWidth="700" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="White" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid>
    <ScrollViewer x:Name="PageScroll" Margin="32,28,24,20"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Height="{Binding ViewportHeight, ElementName=PageScroll}" MinHeight="670" Margin="0,0,20,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,28">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="40" Height="40" CornerRadius="8" Background="#E8F3EE" Margin="0,0,12,0">
              <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#18795E"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel>
              <TextBlock Text="轻提醒" FontSize="24" FontWeight="SemiBold" />
              <TextBlock x:Name="TodayText" FontSize="12" Foreground="#8A928E" Margin="0,4,0,0" />
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="ClockText" Grid.Column="1" Text="00:00:00" FontSize="23" FontWeight="Light"
                     Foreground="#59655F" VerticalAlignment="Center" Margin="16,0,14,0" />
          <Button x:Name="AppMenuButton" Grid.Column="2" Style="{StaticResource IconButton}"
                  Content="&#xE712;" ToolTip="应用菜单" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Grid.Row="1">
          <DockPanel Margin="0,0,0,15">
            <Button x:Name="CancelEditButton" Content="取消" Padding="10,2" MinHeight="26"
                    Visibility="Collapsed" DockPanel.Dock="Right" />
            <TextBlock x:Name="FormHeading" Text="新建提醒" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <Border CornerRadius="6" Background="#F2F5F3" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="CountdownMode" GroupName="Mode" Style="{StaticResource ModeButton}" IsChecked="True">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE916;" Margin="0,0,8,0" VerticalAlignment="Center"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                  <TextBlock Text="倒计时" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="AbsoluteMode" GroupName="Mode" Style="{StaticResource ModeButton}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE121;" Margin="0,0,8,0" VerticalAlignment="Center"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                  <TextBlock Text="指定时间" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </Border>
          <Grid Margin="0,0,0,14">
            <StackPanel x:Name="CountdownPanel">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="小时" FontSize="12" Foreground="#818A85" Margin="0,0,0,7" />
                  <ComboBox x:Name="DelayHours" IsEditable="True" IsTextSearchEnabled="False" Height="52" FontSize="23" AutomationProperties.Name="倒计时小时" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="分钟" FontSize="12" Foreground="#818A85" Margin="0,0,0,7" />
                  <ComboBox x:Name="DelayMinutes" IsEditable="True" IsTextSearchEnabled="False" Height="52" FontSize="23" AutomationProperties.Name="倒计时分钟" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="秒" FontSize="12" Foreground="#818A85" Margin="0,0,0,7" />
                  <ComboBox x:Name="DelaySeconds" IsEditable="True" IsTextSearchEnabled="False" Height="52" FontSize="23" AutomationProperties.Name="倒计时秒钟" />
                </StackPanel>
              </Grid>
            </StackPanel>
            <StackPanel x:Name="AbsolutePanel" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="80" /><ColumnDefinition Width="20" /><ColumnDefinition Width="80" /><ColumnDefinition Width="20" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="日期" FontSize="12" Foreground="#818A85" Margin="0,0,0,7" />
                  <DatePicker x:Name="DateInput" Height="46" VerticalContentAlignment="Center" SelectedDateFormat="Short" AutomationProperties.Name="提醒日期" />
                </StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="时" FontSize="12" Foreground="#818A85" Margin="0,0,0,7" /><ComboBox x:Name="HourInput" Height="46" FontSize="19" AutomationProperties.Name="提醒小时" /></StackPanel>
                <TextBlock Grid.Column="3" Text=":" Foreground="#A1A9A5" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,19,0,0" />
                <StackPanel Grid.Column="4"><TextBlock Text="分" FontSize="12" Foreground="#818A85" Margin="0,0,0,7" /><ComboBox x:Name="MinuteInput" Height="46" FontSize="19" AutomationProperties.Name="提醒分钟" /></StackPanel>
                <TextBlock Grid.Column="5" Text=":" Foreground="#A1A9A5" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,19,0,0" />
                <StackPanel Grid.Column="6"><TextBlock Text="秒" FontSize="12" Foreground="#818A85" Margin="0,0,0,7" /><ComboBox x:Name="SecondInput" Height="46" FontSize="19" AutomationProperties.Name="提醒秒钟" /></StackPanel>
              </Grid>
            </StackPanel>
          </Grid>
          <StackPanel x:Name="PresetPanel" Orientation="Horizontal" Margin="0,0,0,21">
            <Button x:Name="Preset5" Content="5 分钟" Style="{StaticResource QuickPreset}" Margin="0,0,8,0" />
            <Button x:Name="Preset15" Content="15 分钟" Style="{StaticResource QuickPreset}" Margin="0,0,8,0" />
            <Button x:Name="Preset30" Content="30 分钟" Style="{StaticResource QuickPreset}" Margin="0,0,8,0" />
            <Button x:Name="Preset48" Content="48 分钟" Style="{StaticResource QuickPreset}" Margin="0,0,8,0" />
            <Button x:Name="Preset60" Content="1 小时" Style="{StaticResource QuickPreset}" />
          </StackPanel>
          <TextBlock Text="提醒内容（可选）" FontSize="12" Foreground="#818A85" Margin="0,0,0,7" />
          <TextBox x:Name="TitleInput" MaxLength="200" Height="42" AutomationProperties.Name="提醒名称" ToolTip="提醒名称（可留空）" />
          <Grid Margin="0,20,0,24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="PreviewText" Foreground="#7A857E" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
            <Button x:Name="SaveButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" MinWidth="132" Height="42">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SaveIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE710;" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="SaveLabel" Text="添加提醒" Foreground="White" />
              </StackPanel>
            </Button>
          </Grid>
          <TextBlock x:Name="ErrorText" Foreground="#B44935" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,-12,0,15" FontSize="12" />
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="#E8EDEA" BorderThickness="0,1,0,0" Padding="0,20,0,12">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="待提醒" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="CountText" Text="0" Foreground="#8A948E" FontSize="12" Margin="10,3,0,0" />
          </StackPanel>
        </Border>
        <Grid Grid.Row="3">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="AlarmList" /></ScrollViewer>
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,16">
            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#CAD3CE" HorizontalAlignment="Center" Margin="0,0,0,10" />
            <TextBlock Text="暂无待提醒" Foreground="#98A19B" FontSize="12" />
          </StackPanel>
        </Grid>
        <Border Grid.Row="4" BorderBrush="#EDF0EE" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,16,0,0">
          <DockPanel>
            <CheckBox x:Name="SoundToggle" Content="提醒声音" IsChecked="True" Foreground="#79837D" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock x:Name="StatusText" Text="已就绪" FontSize="11" Foreground="#929B95" TextWrapping="Wrap" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
